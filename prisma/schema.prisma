generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ANALYST
  SENIOR_ANALYST
  ADMIN
}

enum DocumentType {
  COMPANY_RESEARCH
  SECTOR_ANALYSIS
  REGION_ANALYSIS
  BROKER_RESEARCH
  NEWS
  EARNINGS_TRANSCRIPT
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ANALYST)
  apiKey       String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  documents    Document[]
  votes        Vote[]
  comments     Comment[]
  reactions    Reaction[]
}

model Region {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  sectors Sector[]
}

model Sector {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id])
  companies Company[]
}

model Company {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  sectorId  String
  sector    Sector            @relation(fields: [sectorId], references: [id])
  documents DocumentCompany[]
  votes     Vote[]
}

model Document {
  id        String            @id @default(cuid())
  slug      String            @unique
  title     String
  content   String
  type      DocumentType
  source    String            @default("web")
  sourceRef String?
  authorId  String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  author        User              @relation(fields: [authorId], references: [id])
  companies     DocumentCompany[]
  tags          DocumentTag[]
  comments      Comment[]
  reactions     Reaction[]
  outgoingLinks DocumentLink[]    @relation("OutgoingLinks")
  incomingLinks DocumentLink[]    @relation("IncomingLinks")

  @@index([type])
  @@index([source])
}

model DocumentCompany {
  documentId String
  companyId  String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id])

  @@id([documentId, companyId])
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  companyId  String
  conviction Int
  rationale  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  documents DocumentTag[]
}

model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([documentId, tagId])
}

model Comment {
  id         String    @id @default(cuid())
  userId     String
  documentId String
  content    String
  parentId   String?
  createdAt  DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id])
  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([documentId])
}

model Reaction {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  emoji      String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId, emoji])
  @@index([documentId])
}

model DocumentLink {
  id          String @id @default(cuid())
  sourceDocId String
  targetDocId String

  sourceDoc Document @relation("OutgoingLinks", fields: [sourceDocId], references: [id], onDelete: Cascade)
  targetDoc Document @relation("IncomingLinks", fields: [targetDocId], references: [id], onDelete: Cascade)

  @@unique([sourceDocId, targetDocId])
  @@index([targetDocId])
}
