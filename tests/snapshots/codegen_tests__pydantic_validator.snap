expression: transpile(source)
---
#[derive(Debug, Clone)]
struct ValidationError {
    field: String,
    message: String,
}

impl ValidationError {
    fn field(field: &str, message: &str) -> Self {
        Self {
            field: field.to_string(),
            message: message.to_string(),
        }
    }
}

impl std::fmt::Display for ValidationError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}: {}", self.field, self.message)
    }
}

#[derive(Debug, Clone)]
struct Email {
    address: String,
}

impl Email {
    fn new(address: String) -> Result<Self, ValidationError> {
        if !address.contains(&"@") {
            return Err(ValidationError::field("address", "must contain @"));
        }
        Ok(Self {
            address,
        })
    }
}
